{
  "name": "file-stats-panel",
  "displayName": "File Stats Panel",
  "description": "File Statistics in VS Code displayed in side panel",
  "publisher": "GreatDeveloper",
  "version": "2.00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreatDeveloper66/file-stats-panel"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "file-stats-panel.showStats",
        "title": "Show File Stats"
      }
    ],
    "keybindings": [
      {
        "command": "file-stats-panel.showStats",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorIsOpen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}